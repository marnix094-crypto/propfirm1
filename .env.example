# Copy to .env — never commit real values.
POSTGRES_USER=brand
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brand
DATABASE_URL=postgresql://brand:change-me@postgres:5432/brand
REDIS_URL=redis://redis:6379

# API
API_PORT=3000
CORS_ORIGINS=http://localhost:5173
# At least 32 random characters, e.g. `openssl rand -base64 48`. Never reuse across environments.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
# binance (Binance USDⓈ-M public data; blocked in some regions) | simulated (dev/CI)
MARKET_DATA_SOURCE=simulated
DEMO_INITIAL_BALANCE_MINOR=10000000

# Web: leave VITE_API_URL empty to use the /api proxy. Dev server proxies /api to this target.
WEB_PORT=5173
VITE_API_URL=
VITE_API_PROXY_TARGET=http://api:3000
# Dev/test only: serve mock data via MSW. Never in production.
VITE_ENABLE_MSW=false

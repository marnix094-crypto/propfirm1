  "info": {
    "title": "BRAND API",
    "description": "Simulated trading platform API. Money: integer strings in minor units (…Minor). Prices/quantities: decimal strings.",
    "version": "0.3.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "InstrumentDto": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "baseAsset": {
            "type": "string"
          },
          "quoteAsset": {
            "type": "string"
          },
          "priceDecimals": {
            "type": "number"
          },
          "qtyDecimals": {
            "type": "number"
          },
          "tickSize": {
            "type": "string",
            "description": "Decimal string"
          },
          "minQty": {
            "type": "string",
            "description": "Decimal string"
          },
          "qtyStep": {
            "type": "string",
            "description": "Decimal string"
          },
          "maxLeverage": {
            "type": "number"
          },
          "commissionBps": {
            "type": "number"
          }
        },
        "required": [
          "symbol",
          "displayName",
          "baseAsset",
          "quoteAsset",
          "priceDecimals",
          "qtyDecimals",
          "tickSize",
          "minQty",
          "qtyStep",
          "maxLeverage",
          "commissionBps"
        ]
      },
      "QuoteDto": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "bid": {
            "type": "string",
            "description": "Decimal string"
          },
          "ask": {
            "type": "string",
            "description": "Decimal string"
          },
          "markPrice": {
            "type": "object",
            "description": "Decimal string",
            "nullable": true
          },
          "fundingRate": {
            "type": "object",
            "description": "Funding rate, decimal string",
            "nullable": true
          },
          "ts": {
            "type": "number"
          }
        },
        "required": [
          "symbol",
          "bid",
          "ask",
          "markPrice",
          "fundingRate",
          "ts"
        ]
      },
      "CandleDto": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number"
          },
          "o": {
            "type": "string"
          },
          "h": {
            "type": "string"
          },
          "l": {
            "type": "string"
          },
          "c": {
            "type": "string"
          },
          "v": {
            "type": "string"
          },
          "closed": {
            "type": "boolean"
          }
        },
        "required": [
          "t",
          "o",
          "h",
          "l",
          "c",
          "v",
          "closed"
        ]
      },
      "FeedStatusDto": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "connecting",
              "connected",
              "down"
            ]
          }
        },
        "required": [
          "source",
          "status"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "trader@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          },
          "country": {
            "type": "string",
            "example": "NL",
            "description": "ISO 3166-1 alpha-2"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "nl",
              "es"
            ]
          },
          "acceptTerms": {
            "type": "boolean",
            "description": "Must be true"
          }
        },
        "required": [
          "email",
          "password",
          "country",
          "locale",
          "acceptTerms"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locale": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "roles",
          "locale",
          "country"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AccountDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "DEMO",
              "CHALLENGE",
              "FUNDED",
              "LIVE_BROKER"
            ]
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "isSimulated": {
            "type": "boolean"
          },
          "currency": {
            "type": "string"
          },
          "initialBalanceMinor": {
            "type": "string"
          },
          "balanceMinor": {
            "type": "string"
          },
          "equityMinor": {
            "type": "string"
          },
          "unrealizedPnlMinor": {
            "type": "string"
          },
          "usedMarginMinor": {
            "type": "string"
          },
          "freeMarginMinor": {
            "type": "string"
          },
          "marginLevelBps": {
            "type": "object",
            "nullable": true
          },
          "dailyPnlMinor": {
            "type": "string",
            "description": "Equity change since 00:00 Europe/Amsterdam"
          },
          "maxLeverage": {
            "type": "number"
          },
          "seq": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "status",
          "isSimulated",
          "currency",
          "initialBalanceMinor",
          "balanceMinor",
          "equityMinor",
          "unrealizedPnlMinor",
          "usedMarginMinor",
          "freeMarginMinor",
          "marginLevelBps",
          "dailyPnlMinor",
          "maxLeverage",
          "seq"
        ]
      },
      "PositionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "LONG",
              "SHORT"
            ]
          },
          "qty": {
            "type": "string"
          },
          "avgEntryPrice": {
            "type": "string"
          },
          "markPrice": {
            "type": "object",
            "nullable": true,
            "description": "Price the position would close at now"
          },
          "leverage": {
            "type": "number"
          },
          "usedMarginMinor": {
            "type": "string"
          },
          "unrealizedPnlMinor": {
            "type": "object",
            "nullable": true
          },
          "realizedPnlMinor": {
            "type": "string"
          },
          "fundingAccruedMinor": {
            "type": "string"
          },
          "slPrice": {
            "type": "object",
            "nullable": true
          },
          "tpPrice": {
            "type": "object",
            "nullable": true
          },
          "openedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "symbol",
          "side",
          "qty",
          "avgEntryPrice",
          "markPrice",
          "leverage",

// BRAND data model — see docs/datamodel.md.
// Money: BigInt minor units (cents). Prices/quantities: BigInt fixed-point using the instrument's decimals.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TRADER
  SUPPORT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

enum AccountKind {
  DEMO
  CHALLENGE
  FUNDED
  LIVE_BROKER
  COMPETITION
}

enum AccountStatus {
  ACTIVE
  PASSED
  FAILED
  PENDING_FUNDED
  FUNDED_ACTIVE
  SUSPENDED
  CLOSED
}

enum Side {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
}

enum OrderStatus {
  PENDING
  OPEN
  FILLED
  CANCELLED
  REJECTED
}

enum OrderSource {
  USER
  SYSTEM_SL
  SYSTEM_TP
  SYSTEM_STOPOUT
  SYSTEM_BREACH
  ADMIN
}

enum PositionSide {
  LONG
  SHORT
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum LedgerType {
  INITIAL_CAPITAL
  REALIZED_PNL
  COMMISSION
  FUNDING
  PAYOUT
  ADJUSTMENT
  RESET
}

enum DrawdownType {
  STATIC
  TRAILING
}

enum TrailingBasis {
  EQUITY
  BALANCE
}

enum DailyLossBasis {
  INITIAL_BALANCE
  DAY_START
}

enum DailyLossReference {
  DAY_START_BALANCE
  DAY_START_EQUITY
  MAX_OF_BOTH
}

enum ProductType {
  INSTANT
  ONE_STEP
  TWO_STEP
}

enum PurchaseStatus {
  PENDING
  PAID
  FULFILLED
  FAILED
  CANCELLED
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ActorType {
  USER
  ADMIN
  SUPPORT
  SYSTEM
}

model User {
  id                 String             @id @default(uuid(7)) @db.Uuid
  email              String             @unique
  emailVerifiedAt    DateTime?
  passwordHash       String
  roles              Role[]             @default([TRADER])
  status             UserStatus         @default(ACTIVE)
  locale             String             @default("en")
  country            String             @db.Char(2)
  termsAcceptedAt    DateTime
  termsVersion       String
  createdAt          DateTime           @default(now())
  lastLoginAt        DateTime?
  refreshTokens      RefreshToken[]
  accounts           TradingAccount[]
  watchlist          Watchlist?
  purchases          Purchase[]
  journalEntries     JournalEntry[]
  pointsEntries      PointsEntry[]
  traderProfile      TraderProfile?
  competitionEntries CompetitionEntry[]
  copierLinks        CopierLink[]
  certificates       Certificate[]
  offers             Offer[]
  twoFactor          TwoFactor?
  emailTokens        EmailToken[]
}

/// TOTP secret is encrypted (AES-256-GCM, FIELD_ENCRYPTION_KEY); recovery codes are hashed.
model TwoFactor {
  userId             String    @id @db.Uuid
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEnc          String
  enabledAt          DateTime?
  recoveryCodeHashes String[]
  lastUsedStep       BigInt?
  createdAt          DateTime  @default(now())
}

/// One-time tokens for email verification and password reset (stored hashed).
model EmailToken {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, purpose])
}

/// Immutable and versioned (decision D5): accounts keep the version they were opened with.
model RuleSet {
  id                      String             @id @default(uuid(7)) @db.Uuid
  code                    String
  version                 Int
  name                    String
  maxDailyLossBps         Int
  dailyLossBasis          DailyLossBasis
  dailyLossReference      DailyLossReference
  maxDrawdownBps          Int
  drawdownType            DrawdownType
  trailingBasis           TrailingBasis
  trailingLocksAtInitial  Boolean
  profitTargetBps         Int?
  minTradingDays          Int                @default(0)
  maxLeverage             Int
  profitSplitBps          Int?
  warnRatioBps            Int                @default(7000)
  isExample               Boolean            @default(false)
  /// Funded-account economics (null = not offered by this version).
  payoutIntervalDays      Int?
  minTradingDaysPerPayout Int?
  minPayoutMinor          BigInt?
  scalingProfitTargetBps  Int?
  scalingMinPayouts       Int?
  scalingStepBps          Int?
  scalingMaxBalanceMinor  BigInt?
  createdAt               DateTime           @default(now())
  accounts                TradingAccount[]
  products                Product[]
  quotes                  PriceQuote[]
  purchases               Purchase[]

  @@unique([code, version])
}

model RuleViolation {
  id            String         @id @default(uuid(7)) @db.Uuid
  accountId     String         @db.Uuid
  account       TradingAccount @relation(fields: [accountId], references: [id])
  ruleSetId     String         @db.Uuid
  rule          String
  floorMinor    BigInt
  observedMinor BigInt
  details       Json
  createdAt     DateTime       @default(now())

  @@index([accountId])
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Instrument {
  id                       String     @id @default(uuid(7)) @db.Uuid
  symbol                   String     @unique
  displayName              String
  assetClass               String     @default("CRYPTO")
  baseAsset                String
  quoteAsset               String
  priceDecimals            Int
  qtyDecimals              Int
  tickSize                 BigInt
  minQty                   BigInt
  qtyStep                  BigInt
  maxLeverage              Int
  spreadMarkupBps          Int
  commissionBps            Int
  slippageBaseBps          Int
  slippageImpactBpsPer100k Int
  slippageMaxBps           Int
  fundingIntervalHours     Int        @default(8)
  marketDataSource         String     @default("binance-usdm")
  externalSymbol           String
  isActive                 Boolean    @default(true)
  sortOrder                Int        @default(0)
  orders                   Order[]
  positions                Position[]
  fills                    Fill[]
}

model TradingAccount {
  id                     String            @id @default(uuid(7)) @db.Uuid
  userId                 String            @db.Uuid
  user                   User              @relation(fields: [userId], references: [id])
  kind                   AccountKind
  isSimulated            Boolean           @default(true)
  status                 AccountStatus     @default(ACTIVE)
  label                  String
  currency               String            @default("USD")
  initialBalanceMinor    BigInt
  balanceMinor           BigInt
  highWaterMarkMinor     BigInt
  maxLeverage            Int               @default(50)
  stopOutLevelBps        Int               @default(5000)
  seq                    BigInt            @default(0)
  ruleSetId              String?           @db.Uuid
  ruleSet                RuleSet?          @relation(fields: [ruleSetId], references: [id])
  /// Peak used by trailing drawdown (equity or balance per rule set).
  ruleHighWaterMarkMinor BigInt?
  dayStartBalanceMinor   BigInt?
  dayStartEquityMinor    BigInt?
  /// Trading day (YYYY-MM-DD, Europe/Amsterdam) the day-start values belong to.
  dayStartDate           String?
  tradingDaysCount       Int               @default(0)
  lastTradingDate        String?
  failReason             String?
  /// Funded accounts: payout cycle and scaling bookkeeping.
  payoutCycleStartedAt   DateTime?
  cycleTradingDays       Int               @default(0)
  payoutsCount           Int               @default(0)
  payoutBaselineMinor    BigInt?
  paidOutSinceScaleMinor BigInt            @default(0)
  purchaseId             String?           @db.Uuid
  purchase               Purchase?         @relation(fields: [purchaseId], references: [id])
  journalEntries         JournalEntry[]
  competitionEntry       CompetitionEntry?
  copierAsMaster         CopierLink[]      @relation("CopierMaster")
  copierAsFollower       CopierLink?       @relation("CopierFollower")
  certificate            Certificate?
  violations             RuleViolation[]
  createdAt              DateTime          @default(now())
  endedAt                DateTime?
  orders                 Order[]
  positions              Position[]
  fills                  Fill[]
  ledger                 LedgerEntry[]
  equitySnapshots        EquitySnapshot[]

  @@index([userId])
}

model Order {
  id            String         @id @default(uuid(7)) @db.Uuid
  accountId     String         @db.Uuid
  account       TradingAccount @relation(fields: [accountId], references: [id])
  clientOrderId String
  instrumentId  String         @db.Uuid
  instrument    Instrument     @relation(fields: [instrumentId], references: [id])
  side          Side
  type          OrderType
  qty           BigInt
  limitPrice    BigInt?
  stopPrice     BigInt?
  slPrice       BigInt?
  tpPrice       BigInt?
  leverage      Int
  reduceOnly    Boolean        @default(false)
  status        OrderStatus
  filledQty     BigInt         @default(0)
  avgFillPrice  BigInt?
  rejectCode    String?
  source        OrderSource    @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  fills         Fill[]

  @@unique([accountId, clientOrderId])
  @@index([accountId, status])
  @@index([instrumentId, status])
}

model Fill {
  id                String         @id @default(uuid(7)) @db.Uuid
  orderId           String         @db.Uuid
  order             Order          @relation(fields: [orderId], references: [id])
  accountId         String         @db.Uuid
  account           TradingAccount @relation(fields: [accountId], references: [id])
  instrumentId      String         @db.Uuid
  instrument        Instrument     @relation(fields: [instrumentId], references: [id])
  side              Side
  qty               BigInt
  price             BigInt
  referencePrice    BigInt
  spreadCostMinor   BigInt
  slippageCostMinor BigInt
  commissionMinor   BigInt
  realizedPnlMinor  BigInt
  executedAt        DateTime       @default(now())

  @@index([accountId, executedAt])
}

model Position {
  id                  String         @id @default(uuid(7)) @db.Uuid
  accountId           String         @db.Uuid
  account             TradingAccount @relation(fields: [accountId], references: [id])
  instrumentId        String         @db.Uuid
  instrument          Instrument     @relation(fields: [instrumentId], references: [id])
  side                PositionSide
  qty                 BigInt
  avgEntryPrice       BigInt
  leverage            Int
  realizedPnlMinor    BigInt         @default(0)
  fundingAccruedMinor BigInt         @default(0)
  slPrice             BigInt?
  tpPrice             BigInt?
  status              PositionStatus @default(OPEN)
  openedAt            DateTime       @default(now())
  closedAt            DateTime?
  lastFundingAt       DateTime?

  @@index([accountId, status])
  @@index([instrumentId, status])
}

model LedgerEntry {
  id                BigInt         @id @default(autoincrement())
  accountId         String         @db.Uuid
  account           TradingAccount @relation(fields: [accountId], references: [id])
  type              LedgerType
  amountMinor       BigInt
  balanceAfterMinor BigInt
  refType           String?
  refId             String?
  createdAt         DateTime       @default(now())

  @@index([accountId, id])
}

model EquitySnapshot {
  accountId       String         @db.Uuid
  account         TradingAccount @relation(fields: [accountId], references: [id])
  ts              DateTime
  balanceMinor    BigInt
  equityMinor     BigInt
  usedMarginMinor BigInt

  @@id([accountId, ts])
}

model Watchlist {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbols   String[]
  updatedAt DateTime @updatedAt
}

model IdempotencyKey {
  key            String
  userId         String   @db.Uuid
  route          String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@id([userId, key])
  @@index([expiresAt])
}

/// Append-only. UPDATE/DELETE are blocked by a trigger (see migration). Contains no PII.
model AuditLog {
  id         BigInt    @id @default(autoincrement())
  ts         DateTime  @default(now())
  actorType  ActorType
  actorId    String?   @db.Uuid
  action     String
  entityType String
  entityId   String
  data       Json
  requestId  String?
  prevHash   String
  hash       String    @unique

  @@index([entityType, entityId])
  @@index([actorId])
}

/// Catalogue item shown on the pricing page. The purchase snapshots size, price and rule set.
model Product {
  id               String      @id @default(uuid(7)) @db.Uuid
  slug             String      @unique
  type             ProductType
  accountSizeMinor BigInt
  priceMinor       BigInt
  priceCurrency    String      @default("EUR") @db.Char(3)
  ruleSetId        String      @db.Uuid
  ruleSet          RuleSet     @relation(fields: [ruleSetId], references: [id])
  isRecommended    Boolean     @default(false)
  isActive         Boolean     @default(true)
  isExample        Boolean     @default(false)
  sortOrder        Int         @default(0)
  createdAt        DateTime    @default(now())
  purchases        Purchase[]
}

/// Server-calculated price for a custom account (configurator). Short-lived.
model PriceQuote {
  id               String      @id @default(uuid(7)) @db.Uuid
  type             ProductType
  accountSizeMinor BigInt
  maxDrawdownBps   Int
  priceMinor       BigInt
  priceCurrency    String      @default("EUR") @db.Char(3)
  ruleSetId        String      @db.Uuid
  ruleSet          RuleSet     @relation(fields: [ruleSetId], references: [id])
  expiresAt        DateTime
  createdAt        DateTime    @default(now())
  purchases        Purchase[]

  @@index([expiresAt])
}

/// A checkout. Amounts are snapshotted; accounts are created once the payment is confirmed.
model Purchase {
  id               String           @id @default(uuid(7)) @db.Uuid
  userId           String           @db.Uuid
  user             User             @relation(fields: [userId], references: [id])
  productId        String?          @db.Uuid
  product          Product?         @relation(fields: [productId], references: [id])
  quoteId          String?          @db.Uuid
  quote            PriceQuote?      @relation(fields: [quoteId], references: [id])
  type             ProductType
  quantity         Int
  accountSizeMinor BigInt
  unitPriceMinor   BigInt
  totalMinor       BigInt
  currency         String           @db.Char(3)
  ruleSetId        String           @db.Uuid
  ruleSet          RuleSet          @relation(fields: [ruleSetId], references: [id])
  status           PurchaseStatus   @default(PENDING)
  provider         String
  providerRef      String?
  paymentUrl       String?
  termsAcceptedAt  DateTime
  paidAt           DateTime?
  fulfilledAt      DateTime?
  failureCode      String?
  /// Discount from an offer code (EUR minor units); totalMinor = unit × quantity − discount.
  discountMinor    BigInt           @default(0)
  offer            Offer?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  accounts         TradingAccount[]
  events           PaymentEvent[]

  @@unique([provider, providerRef])
  @@index([userId, createdAt])
}

/// Payment provider events, deduplicated per (provider, eventId) — webhooks may be delivered twice.
model PaymentEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  provider   String
  eventId    String
  type       String
  purchaseId String   @db.Uuid
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
}

/// Trading journal ("Notebook"). User-written content; deleted with the user.
model JournalEntry {
  id        String          @id @default(uuid(7)) @db.Uuid
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String?         @db.Uuid
  account   TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Trading day the note is about (YYYY-MM-DD, Europe/Amsterdam).
  date      String          @db.Char(10)
  title     String          @db.VarChar(120)
  body      String
  tags      String[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, id])
}

enum PointsReason {
  TRADING_DAY
  EMAIL_VERIFIED
  TWO_FACTOR
  FUNDED_ACCOUNT
  REDEEM
}

/// Daily Points ledger: append-only, one row per (user, reason, refKey) — awards are idempotent.
model PointsEntry {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    PointsReason
  refKey    String
  amount    Int
  createdAt DateTime     @default(now())

  @@unique([userId, reason, refKey])
  @@index([userId, id])
}

/// Personal discount code (e.g. redeemed with Daily Points). Used once, by its owner.
model Offer {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String    @unique
  discountBps Int
  source      String
  rewardId    String?
  expiresAt   DateTime
  usedAt      DateTime?
  purchaseId  String?   @unique @db.Uuid
  purchase    Purchase? @relation(fields: [purchaseId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([userId, id])
}

/// Public trader identity: a nickname only (never name or email). Leaderboard is opt-in.
model TraderProfile {
  userId           String   @id @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname         String   @unique @db.VarChar(20)
  leaderboardOptIn Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

/// Time-boxed trading competition: every entrant gets the same simulated starting balance.
model Competition {
  id                   String             @id @default(uuid(7)) @db.Uuid
  slug                 String             @unique
  name                 String
  startsAt             DateTime
  endsAt               DateTime
  startingBalanceMinor BigInt
  maxLeverage          Int                @default(50)
  /// Prize description; null = no prize.
  prize                String?
  createdAt            DateTime           @default(now())
  entries              CompetitionEntry[]
}

model CompetitionEntry {
  id            String         @id @default(uuid(7)) @db.Uuid
  competitionId String         @db.Uuid
  competition   Competition    @relation(fields: [competitionId], references: [id])
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId     String         @unique @db.Uuid
  account       TradingAccount @relation(fields: [accountId], references: [id])
  joinedAt      DateTime       @default(now())

  @@unique([competitionId, userId])
}

/// Trade copier: user-placed fills on the master are mirrored to the follower (same user).
model CopierLink {
  id                String         @id @default(uuid(7)) @db.Uuid
  userId            String         @db.Uuid
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterAccountId   String         @db.Uuid
  masterAccount     TradingAccount @relation("CopierMaster", fields: [masterAccountId], references: [id])
  followerAccountId String         @unique @db.Uuid
  followerAccount   TradingAccount @relation("CopierFollower", fields: [followerAccountId], references: [id])
  /// Size factor in basis points (10000 = same size).
  multiplierBps     Int
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  events            CopyEvent[]

  @@index([masterAccountId])
}

/// Outcome of copying one master order to one follower (exactly once per pair).
model CopyEvent {
  id              String     @id @default(uuid(7)) @db.Uuid
  linkId          String     @db.Uuid
  link            CopierLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  masterOrderId   String     @db.Uuid
  followerOrderId String?    @db.Uuid
  symbol          String
  side            Side
  qty             String
  status          String
  code            String?
  createdAt       DateTime   @default(now())

  @@unique([linkId, masterOrderId])
  @@index([linkId, id])
}

/// Certificate for a funded account; publicly verifiable by id (no personal data).
model Certificate {
  id               String         @id @default(uuid(7)) @db.Uuid
  userId           String         @db.Uuid
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String         @unique @db.Uuid
  account          TradingAccount @relation(fields: [accountId], references: [id])
  type             String
  accountSizeMinor BigInt
  issuedAt         DateTime       @default(now())
}

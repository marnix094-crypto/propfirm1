# Copy to .env — never commit real values.
POSTGRES_USER=brand
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brand
DATABASE_URL=postgresql://brand:change-me@postgres:5432/brand
REDIS_URL=redis://redis:6379

# API
API_PORT=3000
CORS_ORIGINS=http://localhost:5173
# At least 32 random characters, e.g. `openssl rand -base64 48`. Never reuse across environments.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts 2FA secrets at rest. Back it up: losing it disables all 2FA.
FIELD_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# Links in emails point here.
APP_BASE_URL=http://localhost:5173
# Dev: Mailpit (http://localhost:8025). Without SMTP_URL, emails are written to the API log.
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Daily Funded <no-reply@example.com>
# Development helpers (e.g. example funded account). Must be false in production.
DEV_TOOLS_ENABLED=true
# Payment provider: "fake" = test payments, no real money (forbidden in production)
PAYMENT_PROVIDER=fake
# Optional: inbox that receives demo requests from the website
# SALES_EMAIL=sales@example.com
# binance (Binance USDⓈ-M public data; blocked in some regions) | simulated (dev/CI)
MARKET_DATA_SOURCE=simulated
DEMO_INITIAL_BALANCE_MINOR=10000000

# Web: leave VITE_API_URL empty to use the /api proxy. Dev server proxies /api to this target.
WEB_PORT=5173
VITE_API_URL=
VITE_API_PROXY_TARGET=http://api:3000
# Dev server host check: comma-separated hosts, or "all" for remote previews (dev only).
VITE_ALLOWED_HOSTS=
# Dev/test only: serve mock data via MSW. Never in production.
VITE_ENABLE_MSW=false

# Multi-tenancy: firm used when the request names none (X-Firm header) and the host matches no firm domain.
DEFAULT_FIRM_SLUG=daily-funded
# Compete (separate product, D97): default operator + scheduler/drawdown loop
COMPETE_DEFAULT_OPERATOR_SLUG=your-arena
COMPETE_LOOP_ENABLED=true
# Automatic Compete operator subdomains: <slug>.<COMPETE_BASE_DOMAIN> (wildcard DNS + TLS via the edge, D108)
# COMPETE_BASE_DOMAIN=play.dailyfunded.com
# Admin panel requires 2FA. Set to false ONLY for local dev/e2e (refused in production).
ADMIN_REQUIRE_2FA=true

# Automatic firm set-up (D93-D95)
# Platform domain for automatic subdomains (acme.<domain>); needs a wildcard DNS record *.<domain>.
# PLATFORM_BASE_DOMAIN=dailyfunded.com
# Where firms point their own domain (CNAME). Default: tenants.<PLATFORM_BASE_DOMAIN>
# PLATFORM_CNAME_TARGET=tenants.dailyfunded.com
DNS_RESOLVER=system
# Dedicated firm databases: none | postgres (needs DATABASE_ADMIN_URL with CREATEDB)
DATABASE_PROVISIONER=none
# DATABASE_ADMIN_URL=postgresql://provisioner:change-me@localhost:5432/postgres
# shared = platform + control plane; dedicated = instance for one firm (see docs/provisioning.md)
INSTANCE_MODE=shared
# Protects /internal/* (edge routing + TLS allow-list), header X-Internal-Token. Required in production with PLATFORM_BASE_DOMAIN.
# INTERNAL_API_TOKEN=change-me-to-a-long-random-value

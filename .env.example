# Copy to .env — never commit real values.
POSTGRES_USER=brand
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brand
DATABASE_URL=postgresql://brand:change-me@postgres:5432/brand
REDIS_URL=redis://redis:6379
API_PORT=3000
WEB_PORT=5173
# Web: leave VITE_API_URL empty to use the /api proxy. Dev server proxies /api to this target.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://api:3000
# Dev/test only: serve mock data via MSW (true until the real API lands in phase 5). Never in production.
VITE_ENABLE_MSW=true
